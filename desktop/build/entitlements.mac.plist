<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's JIT (V8) under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Native addons signed with a different (or no) Team ID:
       onnxruntime, sherpa-onnx, node-pty, better-sqlite3. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Dictation / voice cloner record from the microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Computer Use drives other apps through Apple Events (osascript and the
       accessibility bridge). Without this the hardened runtime refuses them
       with errAEPrivilegeError (-10004), which is what the agent hit. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
