{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      // The leaked tree imports OUR modules as it is absorbed — see the
      // @main note in electron.vite.config.ts.
      "@main/*": ["./src/main/*"],
      // The quarantine: Anthropic's own product code, gathered so its
      // remaining edges are visible. See scripts/vendor-plan-anthropic.mjs.
      "@anthropic/*": ["./src/anthropic/*"],
      // bun:bundle is a Bun-only virtual module — shim provides feature().
      "bun:bundle": ["./src/main/shims/bun-bundle.ts"],
      // Vendor imports the Bun-style 'vscode-jsonrpc/node.js' subpath; the
      // package's exports map only knows './node'.
      "vscode-jsonrpc/node.js": ["./node_modules/vscode-jsonrpc/lib/node/main.d.ts"],
      // Throwing stubs for Anthropic-internal / cloud-provider / native
      // packages the vendor tree references but the desktop never executes.
      // Generated by scripts (see src/main/shims/pkg-stubs/) — keep in sync
      // with the alias block in electron.vite.config.ts.
      "@ant/*": ["./src/main/shims/pkg-stubs/ant.ts"],
      "@aws-sdk/*": ["./src/main/shims/pkg-stubs/aws-sdk.ts"],
      "@smithy/*": ["./src/main/shims/pkg-stubs/smithy.ts"],
      "@anthropic-ai/bedrock-sdk": ["./src/main/shims/pkg-stubs/anthropic-ai-bedrock-sdk.ts"],
      "@anthropic-ai/bedrock-sdk/*": ["./src/main/shims/pkg-stubs/anthropic-ai-bedrock-sdk.ts"],
      "@anthropic-ai/foundry-sdk": ["./src/main/shims/pkg-stubs/anthropic-ai-foundry-sdk.ts"],
      "@anthropic-ai/foundry-sdk/*": ["./src/main/shims/pkg-stubs/anthropic-ai-foundry-sdk.ts"],
      "@anthropic-ai/vertex-sdk": ["./src/main/shims/pkg-stubs/anthropic-ai-vertex-sdk.ts"],
      "@anthropic-ai/vertex-sdk/*": ["./src/main/shims/pkg-stubs/anthropic-ai-vertex-sdk.ts"],
      "@anthropic-ai/sandbox-runtime": ["./src/main/shims/pkg-stubs/anthropic-ai-sandbox-runtime.ts"],
      "@anthropic-ai/sandbox-runtime/*": ["./src/main/shims/pkg-stubs/anthropic-ai-sandbox-runtime.ts"],
      "@anthropic-ai/mcpb": ["./src/main/shims/pkg-stubs/anthropic-ai-mcpb.ts"],
      "@anthropic-ai/mcpb/*": ["./src/main/shims/pkg-stubs/anthropic-ai-mcpb.ts"],
      "@azure/identity": ["./src/main/shims/pkg-stubs/azure-identity.ts"],
      "google-auth-library": ["./src/main/shims/pkg-stubs/google-auth-library.ts"],
      "audio-capture-napi": ["./src/main/shims/pkg-stubs/audio-capture-napi.ts"],
      "image-processor-napi": ["./src/main/shims/pkg-stubs/image-processor-napi.ts"],
      "sharp": ["./src/main/shims/pkg-stubs/sharp.ts"],
      "@opentelemetry/api-logs": ["./src/main/shims/pkg-stubs/opentelemetry-api-logs.ts"],
      "@opentelemetry/core": ["./src/main/shims/pkg-stubs/opentelemetry-core.ts"],
      "@opentelemetry/resources": ["./src/main/shims/pkg-stubs/opentelemetry-resources.ts"],
      "@opentelemetry/semantic-conventions": ["./src/main/shims/pkg-stubs/opentelemetry-semantic-conventions.ts"],
      "@opentelemetry/sdk-logs": ["./src/main/shims/pkg-stubs/opentelemetry-sdk-logs.ts"],
      "@opentelemetry/sdk-metrics": ["./src/main/shims/pkg-stubs/opentelemetry-sdk-metrics.ts"],
      "@opentelemetry/sdk-trace-base": ["./src/main/shims/pkg-stubs/opentelemetry-sdk-trace-base.ts"],
      "@opentelemetry/exporter-logs-otlp-grpc": ["./src/main/shims/pkg-stubs/opentelemetry-exporter-logs-otlp-grpc.ts"],
      "@opentelemetry/exporter-logs-otlp-http": ["./src/main/shims/pkg-stubs/opentelemetry-exporter-logs-otlp-http.ts"],
      "@opentelemetry/exporter-logs-otlp-proto": ["./src/main/shims/pkg-stubs/opentelemetry-exporter-logs-otlp-proto.ts"],
      "@opentelemetry/exporter-metrics-otlp-grpc": ["./src/main/shims/pkg-stubs/opentelemetry-exporter-metrics-otlp-grpc.ts"],
      "@opentelemetry/exporter-metrics-otlp-http": ["./src/main/shims/pkg-stubs/opentelemetry-exporter-metrics-otlp-http.ts"],
      "@opentelemetry/exporter-metrics-otlp-proto": ["./src/main/shims/pkg-stubs/opentelemetry-exporter-metrics-otlp-proto.ts"],
      "@opentelemetry/exporter-prometheus": ["./src/main/shims/pkg-stubs/opentelemetry-exporter-prometheus.ts"],
      "@opentelemetry/exporter-trace-otlp-grpc": ["./src/main/shims/pkg-stubs/opentelemetry-exporter-trace-otlp-grpc.ts"],
      "@opentelemetry/exporter-trace-otlp-http": ["./src/main/shims/pkg-stubs/opentelemetry-exporter-trace-otlp-http.ts"],
      "@opentelemetry/exporter-trace-otlp-proto": ["./src/main/shims/pkg-stubs/opentelemetry-exporter-trace-otlp-proto.ts"],
      "@/*": ["./src/renderer/*"],
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
  },
  // src/anthropic is not listed and does not need to be: it is reached from
  // src/main and tsc follows imports regardless. It is exempted at the gate
  // (scripts/typecheck.mjs), not here — a tsconfig exclusion would hide the
  // count instead of tracking it.
  "include": [
    "src/main/**/*.ts",
    "src/main/**/*.tsx",
    "src/preload/**/*.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
  ],
}
