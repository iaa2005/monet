{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      // The leaked tree imports OUR modules as it is absorbed — see the
      // @main note in electron.vite.config.ts.
      "@main/*": ["./src/main/*"],
      // bun:bundle is a Bun-only virtual module — shim provides feature().
      "bun:bundle": ["./src/main/shims/bun-bundle.ts"],
      // Vendor imports the Bun-style 'vscode-jsonrpc/node.js' subpath; the
      // package's exports map only knows './node'.
      "vscode-jsonrpc/node.js": ["./node_modules/vscode-jsonrpc/lib/node/main.d.ts"],
      // Throwing stubs for Anthropic-internal / cloud-provider / native
      // packages the vendor tree references but the desktop never executes.
      // Generated by scripts (see src/main/shims/pkg-stubs/) — keep in sync
      // with the alias block in electron.vite.config.ts.
      "@ant/*": ["./src/main/shims/pkg-stubs/ant.ts"],
      "@aws-sdk/*": ["./src/main/shims/pkg-stubs/aws-sdk.ts"],
      "@smithy/*": ["./src/main/shims/pkg-stubs/smithy.ts"],
      "@anthropic-ai/bedrock-sdk": ["./src/main/shims/pkg-stubs/anthropic-ai-bedrock-sdk.ts"],
      "@anthropic-ai/bedrock-sdk/*": ["./src/main/shims/pkg-stubs/anthropic-ai-bedrock-sdk.ts"],
      "@anthropic-ai/foundry-sdk": ["./src/main/shims/pkg-stubs/anthropic-ai-foundry-sdk.ts"],
      "@anthropic-ai/foundry-sdk/*": ["./src/main/shims/pkg-stubs/anthropic-ai-foundry-sdk.ts"],
      "@anthropic-ai/vertex-sdk": ["./src/main/shims/pkg-stubs/anthropic-ai-vertex-sdk.ts"],
      "@anthropic-ai/vertex-sdk/*": ["./src/main/shims/pkg-stubs/anthropic-ai-vertex-sdk.ts"],
      "@anthropic-ai/sandbox-runtime": ["./src/main/shims/pkg-stubs/anthropic-ai-sandbox-runtime.ts"],
      "@anthropic-ai/sandbox-runtime/*": ["./src/main/shims/pkg-stubs/anthropic-ai-sandbox-runtime.ts"],
      "@anthropic-ai/mcpb": ["./src/main/shims/pkg-stubs/anthropic-ai-mcpb.ts"],
      "@anthropic-ai/mcpb/*": ["./src/main/shims/pkg-stubs/anthropic-ai-mcpb.ts"],
      "@azure/identity": ["./src/main/shims/pkg-stubs/azure-identity.ts"],
      "google-auth-library": ["./src/main/shims/pkg-stubs/google-auth-library.ts"],
      "audio-capture-napi": ["./src/main/shims/pkg-stubs/audio-capture-napi.ts"],
      "image-processor-napi": ["./src/main/shims/pkg-stubs/image-processor-napi.ts"],
      "sharp": ["./src/main/shims/pkg-stubs/sharp.ts"],
      "@/*": ["./src/renderer/*"],
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
  },
  "include": [
    "src/main/**/*.ts",
    "src/main/**/*.tsx",
    "src/preload/**/*.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
  ],
}
