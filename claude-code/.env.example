# Claude Code — Environment Variables
# Copy this file to .env and fill in your credentials

# REQUIRED: Your Anthropic API key
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL: Custom API base URL (for proxies / alternative endpoints)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OPTIONAL: Model selection via CLI flag (e.g. --model sonnet)
# or set default model:
# CLAUDE_CODE_DEFAULT_MODEL=claude-sonnet-4-6

# OPTIONAL: Disable telemetry (recommended for leaked build)
CLAUDE_CODE_DISABLE_TELEMETRY=1

# OPTIONAL: Skip permissions for trusted directories
# CLAUDE_CODE_DANGEROUSLY_SKIP_PERMISSIONS=1
